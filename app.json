{
  "expo": {
    "name": "HomeOS",
    "slug": "homeos",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "homeos",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "at.homeos.mobile",
      "buildNumber": "1"
    },
    "android": {
      "package": "at.homeos.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F4F5F2"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "defaultChannel": "homeos-reminders"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
