{
  "name": "homeos",
  "version": "0.4.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "prepare:assets": "node scripts/prepare-assets.js",
    "prestart": "npm run prepare:assets",
    "preandroid": "npm run prepare:assets",
    "preios": "npm run prepare:assets",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:android": "eas build --platform android --profile android-apk",
    "build:ios": "eas build --platform ios --profile ios-sideload"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^5.7.1",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~57.0.10",
    "expo-network": "~57.0.0",
    "expo-notifications": "~56.0.14",
    "expo-router": "~57.0.10",
    "expo-secure-store": "~56.0.4",
    "expo-sqlite": "~57.0.0",
    "react": "19.2.3",
    "react-hook-form": "^7.85.0",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  }
}
